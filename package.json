  "scripts": {
    "dev": "concurrently -n next,s3,ws -c cyan,magenta,green \"next dev\" \"node scripts/dev-s3.mjs\" \"node scripts/dev-realtime.mjs\"",
    "dev:next": "next dev",
    "dev:s3": "node scripts/dev-s3.mjs",
    "dev:realtime": "node scripts/dev-realtime.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:e2e": "LEAF_DIST_DIR=.next-e2e next build && playwright test",
    "test:e2e:ui": "LEAF_DIST_DIR=.next-e2e playwright test --ui"
  },
