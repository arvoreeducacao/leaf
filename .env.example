# Banco (MySQL 8 / Aurora MySQL)
DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/leaf
DATABASE_POOL_SIZE=10

# Base dos bancos do vitest: cada worker usa <base>_<VITEST_POOL_ID> (leaf_test_1..leaf_test_6)
LEAF_TEST_DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/leaf_test

# Bancos da suite E2E (recriados do zero a cada execucao)
LEAF_E2E_DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/leaf_e2e
LEAF_E2E_REALTIME_DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/leaf_e2e_realtime

# Auth
BETTER_AUTH_SECRET=troque-este-segredo
BETTER_AUTH_URL=http://localhost:3000

# Storage de imagens
S3_ENDPOINT=http://127.0.0.1:4568
S3_BUCKET=leaf-uploads
S3_ACCESS_KEY_ID=S3RVER
S3_SECRET_ACCESS_KEY=S3RVER
S3_REGION=us-east-1

# Colaboracao em tempo real
LEAF_REALTIME=1
LEAF_REALTIME_PORT=1234
LEAF_REALTIME_SECRET=leaf-dev-realtime

LEAF_ALLOWED_EMAIL_DOMAINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MCP remoto (Streamable HTTP em /api/mcp) com OAuth 2.1 servido pelo proprio Leaf.
# Ausente = ligado fora de producao e desligado em producao.
LEAF_MCP_ENABLED=true
# Tools de escrita do MCP (create_document, update_document). Ausente = ligado.
LEAF_MCP_WRITE=true
