# Banco (MySQL 8 / Aurora MySQL)
DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/leaf
DATABASE_POOL_SIZE=10

# Base dos bancos do vitest: cada worker usa <base>_<VITEST_POOL_ID> (leaf_test_1..leaf_test_6)
LEAF_TEST_DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/leaf_test

# Bancos da suite E2E (recriados do zero a cada execucao)
LEAF_E2E_DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/leaf_e2e
LEAF_E2E_REALTIME_DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/leaf_e2e_realtime

# Auth
BETTER_AUTH_SECRET=troque-este-segredo
BETTER_AUTH_URL=http://localhost:3000

# Storage de imagens
S3_ENDPOINT=http://127.0.0.1:4568
S3_BUCKET=leaf-uploads
S3_ACCESS_KEY_ID=S3RVER
S3_SECRET_ACCESS_KEY=S3RVER
S3_REGION=us-east-1

# Colaboracao em tempo real
LEAF_REALTIME=1
LEAF_REALTIME_PORT=1234
LEAF_REALTIME_SECRET=leaf-dev-realtime

LEAF_ALLOWED_EMAIL_DOMAINS=

# Entrar com o Google (opcional): sem as duas chaves o botao nao aparece
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SSO da empresa por OAuth 2.0 / OIDC (opcional). Com client id e issuer preenchidos,
# o cadastro por email e senha some da tela e a entrada passa a ser pelo provedor.
# PROVIDER_ID entra na coluna provider_id da tabela account: mudar depois desliga quem ja entrou.
LEAF_SSO_CLIENT_ID=
LEAF_SSO_CLIENT_SECRET=
LEAF_SSO_ISSUER=
LEAF_SSO_PROVIDER_ID=
LEAF_SSO_PROVIDER_NAME=
# Padrao: <issuer>/oauth2/authorize e <issuer>/oauth2/token
LEAF_SSO_AUTHORIZATION_URL=
LEAF_SSO_TOKEN_URL=
# Sem esta URL o link de trocar de conta nao aparece
LEAF_SSO_LOGOUT_URL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LEAF_AI_PROVIDER=
LEAF_AI_MODEL=
LEAF_AI_BASE_URL=
LEAF_AI_MAX_OUTPUT_TOKENS=

# Busca semantica: sem OPENAI_API_KEY ela fica desligada e a busca segue so por FULLTEXT
LEAF_EMBEDDING_MODEL=
LEAF_EMBEDDING_DIMENSIONS=
LEAF_EMBEDDING_BASE_URL=

# Base de pull requests do GitHub (opcional; sem token ou sem lista de repos a base fica desligada)
GITHUB_TOKEN=
LEAF_GITHUB_ORG=
LEAF_GITHUB_REPOS=
LEAF_GITHUB_SYNC_SECRET=
LEAF_GITHUB_SYNC_OWNER=

# Capa da página: busca de fotos no Unsplash (opcional; sem a chave a aba fica desligada)
UNSPLASH_ACCESS_KEY=

# MCP remoto (Streamable HTTP em /api/mcp) com OAuth 2.1 servido pelo proprio Leaf.
# Ausente = ligado fora de producao e desligado em producao.
LEAF_MCP_ENABLED=true
# Tools de escrita do MCP (create_document, update_document). Ausente = ligado.
LEAF_MCP_WRITE=true

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
